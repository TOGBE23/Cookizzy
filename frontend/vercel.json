{
  "version": 2,
  "rewrites": [
    { "source": "/api/auth/register", "destination": "/api/auth/register" },
    { "source": "/api/auth/login", "destination": "/api/auth/login" },
    { "source": "/api/auth/profile", "destination": "/api/auth/profile" },
    { "source": "/api/recipes/user/:userId", "destination": "/api/recipes/user" },
    { "source": "/api/recipes/:id", "destination": "/api/recipes/[id]" },
    { "source": "/api/recipes", "destination": "/api/recipes/index" },
    { "source": "/api/users/profile", "destination": "/api/users/profile" },
    { "source": "/api/social/:path*", "destination": "/api/social/index" }
  ]
}